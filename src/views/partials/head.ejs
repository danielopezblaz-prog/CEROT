<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <% const fullTitle = pageMeta && pageMeta.title ? `${pageMeta.title} · ${site.brand} ${site.name}` : `${site.brand} ${site.name} — Lo que pasa en el barrio, contado por sus vecinos`; %>
  <% const description = (pageMeta && pageMeta.description) || site.description; %>
  <% const ogImage = pageMeta && pageMeta.image ? absoluteUrl(pageMeta.image) : absoluteUrl('/img/og-default.png'); %>
  <title><%= fullTitle %></title>
  <meta name="description" content="<%= description %>">
  <link rel="canonical" href="<%= absoluteUrl(currentPath) %>">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="<%= site.name %>">
  <meta name="format-detection" content="telephone=no">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0f5c4c">
  <meta property="og:type" content="<%= (pageMeta && pageMeta.type) || 'website' %>">
  <meta property="og:site_name" content="<%= site.brand %> <%= site.name %>">
  <meta property="og:locale" content="es_ES">
  <meta property="og:title" content="<%= (pageMeta && pageMeta.title) || `${site.brand} ${site.name}` %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:url" content="<%= absoluteUrl(currentPath) %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta name="twitter:card" content="<%= pageMeta && pageMeta.image ? 'summary_large_image' : 'summary' %>">
  <link rel="alternate" type="application/rss+xml" title="Últimas publicaciones" href="/feed.xml">
  <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/app.css?v=<%= assetVersion %>">
  <% if (locals.useMap) { %><link rel="stylesheet" href="/vendor/leaflet/leaflet.css"><% } %>
</head>
<body class="<%= locals.bodyClass || '' %>">
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header class="site-header <%= isMod ? 'nav-mod' : user ? 'nav-user-in' : 'nav-guest' %>">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="<%= site.brand %> <%= site.name %>, inicio">
      <img src="/img/logo.svg" alt="" width="40" height="40" class="brand-logo">
      <span class="brand-text">
        <span class="brand-name"><%= site.name %></span>
        <span class="brand-sub"><%= site.brand %> · <%= site.municipality %></span>
      </span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-principal" data-nav-toggle>
      <%- icon('menu', 'icon-open') %><%- icon('x', 'icon-close') %><span class="sr-only">Menú</span>
    </button>
    <nav id="nav-principal" class="nav" data-nav aria-label="Principal">
      <a class="nav-link <%= isActivePath('/incidencias') && !currentPath.startsWith('/incidencias/nueva') ? 'is-active' : '' %>" href="/incidencias">Incidencias</a>
      <a class="nav-link <%= isActivePath('/mapa') ? 'is-active' : '' %>" href="/mapa">Mapa</a>
      <a class="nav-link <%= isActivePath('/negocios') ? 'is-active' : '' %>" href="/negocios">Negocios</a>
      <% if (isMod) { %>
      <a class="nav-link <%= isActivePath('/estadisticas') ? 'is-active' : '' %>" href="/estadisticas">Estado del barrio</a>
      <a class="nav-link nav-link-extra <%= isActivePath('/informe') ? 'is-active' : '' %>" href="/informe">Informe</a>
      <% } %>
      <a class="nav-link nav-link-extra <%= isActivePath('/recursos') ? 'is-active' : '' %>" href="/recursos">Recursos</a>
      <div class="nav-actions">
        <a class="btn btn-accent btn-sm" href="/incidencias/nueva"><%- icon('plus') %> Publicar</a>
        <% if (user) { %>
          <% if (isMod) { %>
            <% const pend = pendingReports(); %>
            <a class="nav-link nav-link-panel <%= isActivePath('/admin') ? 'is-active' : '' %>" href="/admin"><%- icon('shield') %> Panel <span class="badge-count" title="Denuncias pendientes" data-badge-denuncias <%= pend > 0 ? '' : 'hidden' %>><%= pend %></span></a>
          <% } %>
          <a class="nav-user <%= isActivePath('/perfil') ? 'is-active' : '' %>" href="/perfil" title="Mi perfil"><span class="avatar avatar-sm" style="--av: <%= avatarHue(user.name) %>"><%= initials(user.name) %></span><span class="nav-user-name"><%= user.name %></span></a>
          <form method="post" action="/salir" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-ghost btn-sm" title="Cerrar sesión"><%- icon('logout') %><span class="sr-only">Cerrar sesión</span></button>
          </form>
        <% } else { %>
          <a class="btn btn-ghost btn-sm" href="/acceder<%= currentPath !== '/' ? `?next=${encodeURIComponent(currentUrl)}` : '' %>"><%- icon('user') %> Entrar</a>
        <% } %>
      </div>
    </nav>
  </div>
</header>
<main id="contenido" class="site-main">
  <% const flashes = getFlash(); if (flashes.length) { %>
  <div class="container">
    <div class="flash-stack" role="status" aria-live="polite">
      <% for (const f of flashes) { %>
      <div class="flash flash-<%= f.type %>">
        <%- icon(f.type === 'success' ? 'check' : f.type === 'error' ? 'warning' : 'info') %>
        <span><%= f.message %></span>
        <button type="button" class="flash-close" data-dismiss aria-label="Cerrar aviso"><%- icon('x') %></button>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>
