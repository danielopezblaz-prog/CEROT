<%- include('../partials/head', { bodyClass: 'page-admin' }) %>
<div class="container">
  <%- include('../admin/nav', { active: 'users' }) %>
  <div class="page-head">
    <div><h1>Usuarios</h1><p class="lead"><%= number(result.total) %> cuentas registradas. Aquí se ven el nombre completo y el teléfono, que no son públicos en el foro.</p></div>
  </div>

  <form class="filters card" method="get" action="/admin/usuarios">
    <div class="filters-search"><%- icon('search') %><input type="search" name="q" value="<%= q %>" placeholder="Buscar por nombre o correo…" aria-label="Buscar"></div>
    <div class="filters-actions"><button type="submit" class="btn btn-primary btn-sm">Buscar</button><a class="btn btn-ghost btn-sm" href="/admin/usuarios">Limpiar</a></div>
  </form>

  <div class="card table-wrap">
    <table class="table">
      <thead><tr><th>Usuario</th><th>Rol</th><th class="num">Publ.</th><th class="num">Coment.</th><th>Alta</th><th>Último acceso</th><th>Acciones</th></tr></thead>
      <tbody>
        <% for (const u of result.items) { %>
        <tr class="<%= u.is_banned ? 'row-hidden' : '' %>">
          <td>
            <strong><%= [u.first_name, u.last_name].filter(Boolean).join(' ') || u.name %></strong>
            <% if (u.is_demo) { %> <span class="chip chip-demo">Ejemplo</span><% } %><% if (u.is_banned) { %> <span class="chip chip-hidden">Bloqueado</span><% } %>
            <br><span class="muted small"><%= u.email %><% if (u.phone) { %> · <a href="tel:<%= u.phone.replace(/\s+/g, '') %>"><%= u.phone %></a><% } %></span>
            <br><span class="muted small">En el foro: <%= u.name %></span>
          </td>
          <td>
            <form method="post" action="/admin/usuarios/<%= u.id %>/rol" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select name="rol" class="select-sm" data-autosubmit aria-label="Rol de <%= u.name %>">
                <% for (const [k, v] of Object.entries(ROLES)) { %><option value="<%= k %>" <%= u.role === k ? 'selected' : '' %>><%= v %></option><% } %>
              </select>
            </form>
          </td>
          <td class="num"><%= u.post_count %></td>
          <td class="num"><%= u.comment_count %></td>
          <td><%= formatDate(u.created_at) %></td>
          <td><%= u.last_login_at ? timeAgo(u.last_login_at) : '—' %></td>
          <td class="actions">
            <% if (u.id !== user.id) { %>
            <form method="post" action="/admin/usuarios/<%= u.id %>/<%= u.is_banned ? 'desbloquear' : 'bloquear' %>" class="inline-form" <%= u.is_banned ? '' : `data-confirm="¿Bloquear la cuenta de ${u.name}? No podrá iniciar sesión."` %>>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-ghost btn-sm <%= u.is_banned ? '' : 'btn-danger-text' %>"><%- icon(u.is_banned ? 'check' : 'lock') %> <%= u.is_banned ? 'Desbloquear' : 'Bloquear' %></button>
            </form>
            <% } %>
            <details class="dropdown dropdown-left">
              <summary class="btn btn-ghost btn-sm"><%- icon('refresh') %> Contraseña</summary>
              <form method="post" action="/admin/usuarios/<%= u.id %>/contrasena" class="dropdown-panel">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label class="field"><span>Nueva contraseña para <%= u.name %></span><input type="text" name="contrasena" minlength="8" required placeholder="Mínimo 8 caracteres"></label>
                <button type="submit" class="btn btn-primary btn-sm">Restablecer</button>
                <small class="hint">Comunícasela por un canal seguro y pídele que la cambie.</small>
              </form>
            </details>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/pagination', { result, qs: (o) => { const p = new URLSearchParams(); if (q) p.set('q', q); if (o.page > 1) p.set('pagina', o.page); const s = p.toString(); return s ? `?${s}` : ''; } }) %>
</div>
<%- include('../partials/foot') %>
