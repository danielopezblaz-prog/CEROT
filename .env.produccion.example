# ============================================================
#  Configuración del foro EN PRODUCCIÓN
#  Copia este fichero al servidor como «.env» y rellénalo.
#  No lo subas a ningún repositorio: lleva contraseñas.
# ============================================================

# --- Dominio ---------------------------------------------------------------
# El dominio real, sin https:// y sin barra final. Lo usan Caddy (para pedir el
# certificado) y el propio foro (para los enlaces que se comparten).
DOMINIO=veredadelosestudiantes.es
BASE_URL=https://veredadelosestudiantes.es

# --- Entorno ---------------------------------------------------------------
NODE_ENV=production
# El foro está detrás de Caddy: sin esto vería a todos los vecinos con la misma
# dirección y los límites contra el spam bloquearían a gente inocente.
TRUST_PROXY=1

# --- Secreto de las sesiones ----------------------------------------------
# Genera uno largo y aleatorio con:  npm run secreto
# Si lo cambias, todo el mundo tiene que volver a iniciar sesión.
SESSION_SECRET=

# --- Primer administrador --------------------------------------------------
# Solo se usa la primera vez, para crear la cuenta. Cambia la contraseña nada
# más entrar y borra data/PRIMER-ACCESO.txt del servidor.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Datos del foro --------------------------------------------------------
SITE_NAME=Vereda de los Estudiantes
SITE_BRAND=Foro Vecinal
MUNICIPALITY=Leganés

# Obligatorios por el RGPD: el foro guarda nombres, apellidos y teléfonos de los
# vecinos, así que tiene que constar quién responde de esos datos y a dónde
# escribir para ejercer los derechos de acceso, rectificación y supresión.
LEGAL_OWNER=
CONTACT_EMAIL=

# --- Google (opcional) -----------------------------------------------------
# Si verificas el foro en Google Search Console con la «etiqueta HTML», pega
# aquí solo el código (lo que va dentro de content="..."). Ver README.
GOOGLE_SITE_VERIFICATION=

# --- Contenido de ejemplo --------------------------------------------------
# En producción va en false: el foro abre vacío, esperando a los vecinos.
SEED_DEMO=false

# --- Mapa ------------------------------------------------------------------
MAP_CENTER_LAT=40.3215
MAP_CENTER_LNG=-3.756
MAP_ZOOM=15

# --- Fotos -----------------------------------------------------------------
MAX_UPLOAD_MB=8
MAX_IMAGES_PER_POST=4

# --- Conexiones en vivo ----------------------------------------------------
# Tope por red y cuarto de hora. Solo hay que subirlo si muchos vecinos salen a
# internet por la misma IP.
LIMITE_VIVO=240

# --- Envío de correo (opcional) --------------------------------------------
# Solo se usa para el enlace de «he olvidado mi contraseña». Si se deja vacío,
# quien olvide la suya tendrá que pedírtela a ti. Cómo conseguir la clave, en el
# README, apartado «Recuperar la contraseña».
#   brevo    Brevo, gratis hasta 300 correos al día
#   resend   Resend, gratis hasta 3.000 correos al mes
CORREO_PROVEEDOR=
CORREO_CLAVE=
# El remitente tiene que estar verificado en el proveedor o rechazará el envío.
# Vacío usa CONTACT_EMAIL.
CORREO_REMITENTE=
CORREO_NOMBRE=

# --- Compartir en Facebook (opcional) --------------------------------------
# Déjalo vacío si no lo quieres. Con los dos rellenos aparece el botón
# "Compartir en Facebook" en el panel de moderación. Nunca publica solo.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# --- Solo para pruebas -----------------------------------------------------
# En producción NO lo pongas a 1: es lo que impide arrancar sin HTTPS o con el
# fichero de la contraseña inicial todavía en el disco.
PERMITIR_INSEGURO=0
