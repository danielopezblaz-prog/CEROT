# Copia este archivo como ".env" y ajusta los valores.

# Puerto en el que escucha el servidor
PORT=3000
# URL pública (sin barra final). Se usa para enlaces compartidos, RSS y vistas previas de WhatsApp.
BASE_URL=http://localhost:3000

# Clave secreta para las sesiones. Si se deja vacía se genera una automáticamente en data/.session-secret
SESSION_SECRET=

# Carpeta donde se guardan la base de datos y las fotos subidas
DATA_DIR=./data

# Identidad del foro
SITE_NAME=Vereda de los Estudiantes
SITE_BRAND=Foro Vecinal
MUNICIPALITY=Leganés
SITE_DESCRIPTION=Plataforma vecinal independiente para publicar, apoyar y dar visibilidad a las incidencias y gestiones pendientes del barrio.
# Correo de contacto que se muestra en normas, aviso legal y pantalla de acceso (opcional)
CONTACT_EMAIL=
# Titular que aparece en el aviso legal y la política de privacidad (asociación o persona responsable)
LEGAL_OWNER=

# Centro del mapa (Vereda de los Estudiantes, Leganés)
MAP_CENTER_LAT=40.3215
MAP_CENTER_LNG=-3.7560
MAP_ZOOM=15

# Primer administrador (se crea solo si no existe ningún usuario). Si ADMIN_PASSWORD está vacío se genera una y se muestra en consola.
ADMIN_EMAIL=admin@vereda.local
ADMIN_PASSWORD=

# Tamaño máximo por foto (MB) y número máximo de fotos por publicación
MAX_UPLOAD_MB=8
MAX_IMAGES_PER_POST=4

# Crea contenido de ejemplo la primera vez (se puede borrar desde el panel de administración)
SEED_DEMO=true

# Pon 1 si el servidor está detrás de un proxy inverso (Caddy, Nginx, Railway, Render...)
TRUST_PROXY=0

# En modo producción el foro no arranca si falta algo imprescindible de seguridad
# (servir por HTTPS, borrar data/PRIMER-ACCESO.txt). Pon 1 solo para pruebas internas.
PERMITIR_INSEGURO=0

# Tope de conexiones en vivo por red y cuarto de hora. Solo hay que subirlo si
# muchos vecinos salen a Internet por la misma IP (una comunidad con un router).
LIMITE_VIVO=240

# --- Compartir en Facebook (opcional) ---
# Deja estos campos vacíos si no quieres la función. Con los dos rellenos aparece
# el botón "Compartir en Facebook" en el panel de moderación. Nunca se publica solo.
# Instrucciones para conseguirlos en el README, apartado "Compartir en Facebook".
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_API_VERSION=v25.0
